# Base de datos (obligatoria en Vercel; sin ella la API no arranca para no perder datos)
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=
# Correo para recuperar la contraseña (Resend). En producción, sin esto no se envía nada.
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Pistea <no-reply@tudominio.es>
# Dirección pública de la app (para los enlaces del correo). En Vercel se toma sola del dominio de producción.
APP_URL=https://pistea.tudominio.es
# Solo en servidor propio detrás de Caddy/nginx:
# TRUST_PROXY=1
# DOMAIN=pistea.tudominio.es
# ALLOW_SIM=1   # solo demo: permite días simulados (no usar con usuarios reales)
