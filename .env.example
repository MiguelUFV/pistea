# Base de datos (obligatoria en Vercel; sin ella la API no arranca para no perder datos)
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=
# Correo (verificar la cuenta y recuperar la contraseña): BREVO_API_KEY (gratis, sin dominio) o RESEND_API_KEY (con dominio)
BREVO_API_KEY=
# RESEND_API_KEY=
MAIL_FROM=Pistea <no-reply@tudominio.es>
# Dirección pública de la app (para los enlaces del correo). En Vercel se toma sola del dominio de producción.
APP_URL=https://pistea.tudominio.es
# Solo en servidor propio detrás de Caddy/nginx:
# TRUST_PROXY=1
# DOMAIN=pistea.tudominio.es
# ALLOW_SIM=1   # solo demo: permite días simulados (no usar con usuarios reales)
# Páginas legales (/privacidad, /condiciones): quién es el responsable y cómo contactar
LEGAL_NAME=Nombre Apellido Apellido
LEGAL_EMAIL=contacto@ejemplo.es
# Aviso legal (/aviso-legal, art. 10 LSSI-CE): NIF y domicilio a efectos de notificaciones. Obligatorios en cuanto haya actividad económica
LEGAL_NIF=00000000X
LEGAL_ADDRESS=Calle, número, código postal, ciudad
# Correos de los moderadores (ven las denuncias en Perfil → Moderación), separados por comas
ADMIN_EMAILS=tu@correo.es
